# [ CONFIGURACIÓN DEL SERVIDOR ]
PORT=3001
BACKEND_URL="http://localhost:3001"

# [ BASE DE DATOS (PostgreSQL) ]
DATABASE_URL="postgresql://user:password@localhost:5432/tfi_laboratorio?schema=public"

# [ SEGURIDAD ]
JWT_SECRET="una_clave_secreta_muy_larga_y_segura_123"

# [ LLAVES MAESTRAS DE APIs (Oficiales del Laboratorio) ]
ZENODO_TOKEN="tu_token_de_zenodo_aqui"
KAGGLE_USER="tu_usuario_de_kaggle"
KAGGLE_KEY="tu_api_key_de_kaggle"
HUGGINGFACE_TOKEN="tu_token_de_huggingface"

# [ EMAIL — recuperación de contraseña con Resend ]
# Registrate gratis en https://resend.com — 3.000 emails/mes gratis
# RESEND_FROM requiere dominio verificado en Resend (o usá onboarding@resend.dev solo para pruebas)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"
RESEND_FROM="Laboratorio CAETI UAI <noreply@tudominio.com>"

# [ GOOGLE OAUTH — login con Google ]
# Crear credenciales OAuth 2.0 en https://console.cloud.google.com
# Agregar http://localhost:5173 como Origen JS autorizado
GOOGLE_CLIENT_ID="xxxxxx.apps.googleusercontent.com"

# [ URL DEL FRONTEND — para el link de reseteo en el email ]
FRONTEND_URL="http://localhost:5173"

# [ RUTAS DEL SISTEMA ]
PYTHON_PATH="python"
EXPORTS_PATH="../exports"
