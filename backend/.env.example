# [ CONFIGURACIÓN DEL SERVIDOR ]
PORT=3001
BACKEND_URL="http://localhost:3001"

# [ BASE DE DATOS (PostgreSQL) ]
# Reemplaza con tus datos reales de PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/tfi_laboratorio?schema=public"

# [ SEGURIDAD ]
JWT_SECRET="una_clave_secreta_muy_larga_y_segura_123"

# [ LLAVES MAESTRAS DE APIs (Oficiales del Laboratorio) ]
# Estas llaves se usan en la "Búsqueda Integral"
ZENODO_TOKEN="tu_token_de_zenodo_aqui"
KAGGLE_USER="tu_usuario_de_kaggle"
KAGGLE_KEY="tu_api_key_de_kaggle"
HUGGINGFACE_TOKEN="tu_token_de_huggingface"

# [ EMAIL — para recuperación de contraseña ]
# Usá una App Password de Gmail (no la contraseña normal)
# https://myaccount.google.com/apppasswords
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT="587"
EMAIL_USER="tu@gmail.com"
EMAIL_PASS="xxxx xxxx xxxx xxxx"

# [ URL DEL FRONTEND — para el link de reseteo en el email ]
FRONTEND_URL="http://localhost:5173"

# [ RUTAS DEL SISTEMA ]
PYTHON_PATH="python"
EXPORTS_PATH="../exports"
